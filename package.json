    "seed:gen": "tsx scripts/generate-seed.ts",
    "rls:proof": "tsx scripts/rls-proof.ts",
    "demo:reset": "pnpm db:reset",
    "e2e": "playwright test",
    "lh": "lhci autorun"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.3.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "clsx": "^2.1.1",
    "next": "^15.5.29",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resend": "^6.38.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "stripe": "^23.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@lhci/cli": "^0.16.1",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.29",
    "postcss": "^8.5.32",
    "prettier": "^3.10.1",
    "supabase": "^3.1.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "supabase",
      "@lhci/cli",
      "unrs-resolver"
