# ---------- Mode ----------
# mock = local Supabase + simulated payments + emails land in /admin/outbox + demo login
# live = real Supabase, Stripe, Resend, magic-link admin auth
NEXT_PUBLIC_APP_MODE=mock
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# ---------- Supabase ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# server only. Never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Signing secrets (32+ random bytes each: openssl rand -base64 32) ----------
SESSION_SECRET=
ORDER_TOKEN_SECRET=
CRON_SECRET=

# ---------- Stripe (live mode only) ----------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ---------- Resend (live mode only) ----------
RESEND_API_KEY=
EMAIL_FROM=

# ---------- Cloudflare Turnstile (stubbed in mock) ----------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------- SMS (optional; outbox only until a provider is wired) ----------
SMS_PROVIDER=
